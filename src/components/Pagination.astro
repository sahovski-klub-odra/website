---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { withBase } from '../i18n/routes';

interface Props { lang: Lang; page: number; pages: number; hrefFor: (page: number) => string }
const { lang, page, pages, hrefFor } = Astro.props;
const t = useTranslations(lang);
if (pages <= 1) return;

// 1 … 4 5 [6] 7 8 … 20
const nums = [...new Set([1, page - 2, page - 1, page, page + 1, page + 2, pages])]
  .filter((n) => n >= 1 && n <= pages)
  .sort((a, b) => a - b);
const items: (number | 'gap')[] = [];
nums.forEach((n, i) => {
  if (i > 0 && n - nums[i - 1] > 1) items.push('gap');
  items.push(n);
});
const base = 'grid h-10 min-w-10 place-items-center rounded-md px-3 text-sm font-semibold';
---
<nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label={t('news.page')}>
  {page > 1 && (
    <a href={withBase(hrefFor(page - 1))} rel="prev" class={`${base} gap-1.5 bg-white ring-1 ring-ink/10 hover:ring-gold`}>
      <span class="flex items-center gap-1.5"><Icon name="chevronLeft" size={16} /> {t('news.prev')}</span>
    </a>
  )}
  {items.map((it) =>
    it === 'gap' ? (
      <span class="px-1 text-ink/40" aria-hidden="true">…</span>
    ) : it === page ? (
      <span aria-current="page" class={`${base} bg-ink text-gold`}>{it}</span>
    ) : (
      <a href={withBase(hrefFor(it))} class={`${base} bg-white ring-1 ring-ink/10 hover:ring-gold`} aria-label={`${t('news.page')} ${it}`}>{it}</a>
    ),
  )}
  {page < pages && (
    <a href={withBase(hrefFor(page + 1))} rel="next" class={`${base} bg-white ring-1 ring-ink/10 hover:ring-gold`}>
      <span class="flex items-center gap-1.5">{t('news.next')} <Icon name="chevronRight" size={16} /></span>
    </a>
  )}
</nav>
