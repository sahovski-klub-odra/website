---
/**
 * Fullscreen photo viewer (native <dialog>, ~2 KB of JS, no library).
 * Works for:
 *  • gallery links:  <a href="full.jpg" data-lightbox="album-id" data-caption="…"><img …></a>
 *  • article images: every <img> inside [data-lightbox-scope]
 * Keyboard: ←/→ to navigate, Esc to close. Touch: swipe left/right.
 */
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<dialog class="lightbox" aria-label="Photo viewer" data-lb>
  <div class="relative flex h-full w-full flex-col">
    <div class="flex items-center justify-between px-4 py-3 text-sm text-white/70">
      <span data-lb-count aria-live="polite"></span>
      <button type="button" data-lb-close class="rounded-full p-2 hover:bg-white/10" aria-label={t('lightbox.close')}>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <figure class="relative m-0 flex min-h-0 flex-1 flex-col items-center justify-center px-2 sm:px-16">
      <img data-lb-img alt="" class="max-h-full max-w-full select-none object-contain" draggable="false" />
      <figcaption data-lb-caption class="mt-3 max-w-3xl px-4 pb-4 text-center text-[0.95rem] text-white/85"></figcaption>
    </figure>
    <button type="button" data-lb-prev class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-3 hover:bg-white/15 sm:left-4" aria-label={t('lightbox.prev')}>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button type="button" data-lb-next class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-3 hover:bg-white/15 sm:right-4" aria-label={t('lightbox.next')}>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</dialog>

<script>
  type Item = { src: string; caption: string; alt: string };
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
  const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
  let items: Item[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    index = (i + items.length) % items.length;
    const it = items[index];
    img.classList.remove('lb-swap'); void img.offsetWidth; img.classList.add('lb-swap');
    img.src = it.src;
    img.alt = it.alt;
    cap.textContent = it.caption;
    count.textContent = `${index + 1} / ${items.length}`;
    const single = items.length < 2;
    dlg.querySelector<HTMLElement>('[data-lb-prev]')!.hidden = single;
    dlg.querySelector<HTMLElement>('[data-lb-next]')!.hidden = single;
    [index + 1, index - 1].forEach((n) => { const p = items[(n + items.length) % items.length]; if (p) new Image().src = p.src; });
  }
  function open(list: Item[], i: number, from: HTMLElement) {
    items = list; opener = from; show(i); dlg.showModal();
  }

  // Gallery links
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a || e.ctrlKey || e.metaKey || e.shiftKey) return;
    e.preventDefault();
    const group = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${a.dataset.lightbox}"]`)];
    open(group.map((g) => ({ src: g.href, caption: g.dataset.caption ?? '', alt: g.querySelector('img')?.alt ?? '' })), group.indexOf(a), a);
  });

  // Article images
  document.querySelectorAll<HTMLElement>('[data-lightbox-scope]').forEach((scope) => {
    const imgs = [...scope.querySelectorAll<HTMLImageElement>('img')].filter((im) => !im.closest('a'));
    const list = () => imgs.map((im) => ({
      src: im.currentSrc || im.src,
      caption: im.closest('figure')?.querySelector('figcaption')?.textContent ?? im.title ?? '',
      alt: im.alt,
    }));
    imgs.forEach((im, i) => {
      im.dataset.zoomable = '';
      im.tabIndex = 0;
      im.setAttribute('role', 'button');
      const go = () => open(list(), i, im);
      im.addEventListener('click', go);
      im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    });
  });

  // closing animation: fade/scale out, then really close (instant when reduced motion is requested)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  function closeLb() {
    if (!dlg.open || dlg.classList.contains('is-closing')) return;
    if (reduce.matches) return dlg.close();
    dlg.classList.add('is-closing');
    setTimeout(() => { dlg.classList.remove('is-closing'); dlg.close(); }, 180);
  }
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', closeLb);
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(index + 1);
    if (e.key === 'ArrowLeft') show(index - 1);
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).tagName === 'FIGURE') closeLb(); });
  dlg.addEventListener('cancel', (e) => { e.preventDefault(); closeLb(); });
  dlg.addEventListener('close', () => { img.removeAttribute('src'); opener?.focus(); });

  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>
