---
/**
 * Fullscreen photo viewer (native <dialog>, ~2 KB of JS, no library).
 * Works for:
 *  • gallery links:  <a href="full.jpg" data-lightbox="album-id" data-caption="…"><img …></a>
 *  • article images: every <img> inside [data-lightbox-scope]
 * Keyboard: ←/→ to navigate, Esc to close, +/− to zoom. Touch: swipe left/right, pinch or double-tap to zoom.
 * Zoom: the magnifying-glass button or a click on the photo zooms in (2×, 3×, back to 1×) at the clicked spot;
 * a zoomed photo is moved by dragging. The same file is shown – it is only enlarged on screen.
 */
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<dialog class="lightbox" aria-label="Photo viewer" data-lb>
  <div class="relative flex h-full w-full flex-col">
    <div class="flex items-center justify-between px-4 py-3 text-sm text-white/70">
      <span data-lb-count aria-live="polite"></span>
      <span class="ml-auto"></span>
      <button type="button" data-lb-zoom-btn class="lb-zoom-btn mr-1 rounded-full p-2 hover:bg-white/10" aria-label="Povećaj fotografiju" aria-pressed="false" title="Povećaj (klik na fotografiju)">
        <svg class="lb-zoom-in" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2M11 8v6M8 11h6"/></svg>
        <svg class="lb-zoom-out" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2M8 11h6"/></svg>
      </button>
      <button type="button" data-lb-close class="rounded-full p-2 hover:bg-white/10" aria-label={t('lightbox.close')}>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <figure class="relative m-0 flex min-h-0 flex-1 flex-col items-center justify-center overflow-hidden px-2 sm:px-16">
      <div class="lb-zoom flex min-h-0 max-h-full max-w-full items-center justify-center" data-lb-zoom>
        <img data-lb-img alt="" class="max-h-full max-w-full select-none object-contain" draggable="false" />
      </div>
      <figcaption data-lb-caption class="mt-3 max-w-3xl px-4 pb-4 text-center text-[0.95rem] text-white/85"></figcaption>
    </figure>
    <button type="button" data-lb-prev class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-3 hover:bg-white/15 sm:left-4" aria-label={t('lightbox.prev')}>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button type="button" data-lb-next class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-3 hover:bg-white/15 sm:right-4" aria-label={t('lightbox.next')}>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</dialog>

<script>
  type Item = { src: string; caption: string; alt: string };
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
  const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
  let items: Item[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    index = (i + items.length) % items.length;
    const it = items[index];
    img.classList.remove('lb-swap'); void img.offsetWidth; img.classList.add('lb-swap');
    resetZoom();
    img.src = it.src;
    img.alt = it.alt;
    cap.textContent = it.caption;
    count.textContent = `${index + 1} / ${items.length}`;
    const single = items.length < 2;
    dlg.querySelector<HTMLElement>('[data-lb-prev]')!.hidden = single;
    dlg.querySelector<HTMLElement>('[data-lb-next]')!.hidden = single;
    [index + 1, index - 1].forEach((n) => { const p = items[(n + items.length) % items.length]; if (p) new Image().src = p.src; });
  }
  function open(list: Item[], i: number, from: HTMLElement) {
    items = list; opener = from; show(i); dlg.showModal();
  }

  // Gallery links
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a || e.ctrlKey || e.metaKey || e.shiftKey) return;
    e.preventDefault();
    const group = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${a.dataset.lightbox}"]`)];
    open(group.map((g) => ({ src: g.href, caption: g.dataset.caption ?? '', alt: g.querySelector('img')?.alt ?? '' })), group.indexOf(a), a);
  });

  // Article images
  document.querySelectorAll<HTMLElement>('[data-lightbox-scope]').forEach((scope) => {
    const imgs = [...scope.querySelectorAll<HTMLImageElement>('img')].filter((im) => !im.closest('a'));
    const list = () => imgs.map((im) => ({
      // src is the full-size WebP; currentSrc may be a smaller srcset candidate
      src: im.getAttribute('src') ? im.src : im.currentSrc,
      caption: im.closest('figure')?.querySelector('figcaption')?.textContent ?? im.title ?? '',
      alt: im.alt,
    }));
    imgs.forEach((im, i) => {
      im.dataset.zoomable = '';
      im.tabIndex = 0;
      im.setAttribute('role', 'button');
      const go = () => open(list(), i, im);
      im.addEventListener('click', go);
      im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    });
  });

  // closing animation: fade/scale out, then really close (instant when reduced motion is requested)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  function closeLb() {
    if (!dlg.open || dlg.classList.contains('is-closing')) return;
    if (reduce.matches) return dlg.close();
    dlg.classList.add('is-closing');
    setTimeout(() => { dlg.classList.remove('is-closing'); dlg.close(); }, 180);
  }
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', closeLb);
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' && scale === 1) show(index + 1);
    if (e.key === 'ArrowLeft' && scale === 1) show(index - 1);
    if (e.key === '+' || e.key === '=') setZoom(Math.min(MAX, scale + 1));
    if (e.key === '-') setZoom(Math.max(1, scale - 1));
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).tagName === 'FIGURE') closeLb(); });
  dlg.addEventListener('cancel', (e) => { e.preventDefault(); closeLb(); });
  dlg.addEventListener('close', () => { img.removeAttribute('src'); opener?.focus(); });

  // swipe to the next/previous photo – only when the photo is not zoomed and with one finger
  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches.length === 1 && scale === 1 ? e.touches[0].clientX : null), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null || scale !== 1 || e.touches.length) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    x0 = null;
  });

  /* ---------- zoom ---------- */
  const MAX = 3;
  const zoomBox = dlg.querySelector<HTMLElement>('[data-lb-zoom]')!;
  const zoomBtn = dlg.querySelector<HTMLButtonElement>('[data-lb-zoom-btn]')!;
  let scale = 1, tx = 0, ty = 0;
  function apply(animate = true) {
    // keep the enlarged photo covering the frame: it can't be dragged past its own edges
    const w = img.clientWidth, h = img.clientHeight;
    const mx = (w * (scale - 1)) / 2, my = (h * (scale - 1)) / 2;
    tx = Math.max(-mx, Math.min(mx, tx));
    ty = Math.max(-my, Math.min(my, ty));
    zoomBox.classList.toggle('is-animating', animate && !reduce.matches);
    zoomBox.style.transform = scale === 1 ? '' : `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
    dlg.classList.toggle('is-zoomed', scale > 1);
    zoomBtn.setAttribute('aria-pressed', String(scale > 1));
    zoomBtn.setAttribute('aria-label', scale > 1 ? 'Vrati na normalnu veličinu' : 'Povećaj fotografiju');
  }
  /** zoom to `next`, keeping the point (px, py) of the screen where it is */
  function setZoom(next: number, px?: number, py?: number) {
    const r = img.getBoundingClientRect();
    const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    if (next === 1) { tx = 0; ty = 0; }
    else if (px !== undefined && py !== undefined) {
      // offset of the point from the centre of the unscaled photo
      const dx = (px - cx) / scale, dy = (py - cy) / scale;
      tx = -dx * (next - 1);
      ty = -dy * (next - 1);
    } else { tx = (tx / scale) * next; ty = (ty / scale) * next; }
    scale = next;
    apply();
  }
  function resetZoom() { scale = 1; tx = 0; ty = 0; apply(false); }
  zoomBtn.addEventListener('click', () => setZoom(scale >= MAX ? 1 : scale + 1));

  // mouse/touch on the photo: click (or double-tap) zooms at that spot, drag moves, two fingers pinch
  img.style.touchAction = 'none';
  const pointers = new Map<number, { x: number; y: number }>();
  let moved = 0, pinch0 = 0, scale0 = 1, lastTap = 0;
  img.addEventListener('pointerdown', (e) => {
    img.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    moved = 0;
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch0 = Math.hypot(a.x - b.x, a.y - b.y);
      scale0 = scale;
    }
  });
  img.addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    if (!prev) return;
    const p = { x: e.clientX, y: e.clientY };
    pointers.set(e.pointerId, p);
    if (pointers.size === 2 && pinch0) {
      const [a, b] = [...pointers.values()];
      const next = Math.max(1, Math.min(4, (scale0 * Math.hypot(a.x - b.x, a.y - b.y)) / pinch0));
      tx = (tx / scale) * next; ty = (ty / scale) * next; scale = next;
      moved += 10;
      return apply(false);
    }
    if (scale > 1) {
      tx += p.x - prev.x; ty += p.y - prev.y;
      apply(false);
    }
    moved += Math.abs(p.x - prev.x) + Math.abs(p.y - prev.y);
  });
  const up = (e: PointerEvent) => {
    if (!pointers.has(e.pointerId)) return;
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinch0 = 0;
    if (pointers.size || moved > 6) { if (scale < 1.05) resetZoom(); return; }
    if (e.pointerType === 'touch') {
      // touch: double-tap zooms in at the spot / back out
      const now = Date.now();
      if (now - lastTap < 300) { setZoom(scale > 1 ? 1 : 2, e.clientX, e.clientY); lastTap = 0; } else lastTap = now;
      return;
    }
    setZoom(scale >= MAX ? 1 : scale + 1, e.clientX, e.clientY);
  };
  img.addEventListener('pointerup', up);
  img.addEventListener('pointercancel', (e) => { pointers.delete(e.pointerId); pinch0 = 0; });
  img.addEventListener('click', (e) => e.stopPropagation()); // a click on the photo never closes the viewer
  addEventListener('resize', () => dlg.open && apply(false));
</script>
