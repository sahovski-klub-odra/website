---
/**
 * "Najbolji na svijetu" – Top 10 in classical chess (men and women) from 2700chess.com, for the homepage sidebar.
 *
 * 2700chess.com has no public API or iframe widget, and its pages may not be scraped. It does offer
 * official, automatically updated Top 10 banners (images) for other websites – the "olive" ones are
 * the banners the old WordPress site used. The banner is drawn by 2700chess, so it always shows their
 * current list (names, flags, live ratings, ranking); nothing is copied or stored here.
 *
 * Each banner is shown only once it has really loaded. If 2700chess blocks it (its bot protection
 * currently refuses images requested from other websites), the tab shows a link card to the live
 * ranking instead – never old or invented numbers.
 */
import Icon from './Icon.astro';
const lists = [
  { id: 'men', tab: 'Šahisti', title: 'Top 10 šahista svijeta', banner: 'https://2700chess.com/files/topten_olive.png', href: 'https://2700chess.com' },
  { id: 'women', tab: 'Šahistice', title: 'Top 10 šahistica svijeta', banner: 'https://2700chess.com/files/topten_women_olive.png', href: 'https://2700chess.com/women' },
] as const;
---
<section class="side-card side-card--dark rank-box" aria-labelledby="ranks-h" data-rank-box>
  <h2 id="ranks-h" class="side-card__title"><Icon name="trophy" size={18} class="text-gold" /> Najbolji na svijetu</h2>
  <p class="side-card__sub">Klasični šah · rejting uživo s 2700chess.com</p>

  <div class="rank-tabs" role="tablist" aria-label="Top 10 svijeta">
    {lists.map((l, i) => (
      <button type="button" role="tab" id={`rank-tab-${l.id}`} aria-controls={`rank-panel-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : -1} data-rank-tab={l.id}>{l.tab}</button>
    ))}
  </div>

  {lists.map((l, i) => (
    <div class="rank-panel" role="tabpanel" id={`rank-panel-${l.id}`} aria-labelledby={`rank-tab-${l.id}`} hidden={i !== 0} data-rank-panel={l.id}>
      <a href={l.href} target="_blank" rel="noopener noreferrer" class="rank-banner" data-rank-banner hidden>
        <img src={l.banner} alt={`${l.title} – trenutačna rang-lista s 2700chess.com`} width="240" height="290" decoding="async" data-rank-img />
      </a>
      <div class="rank-fallback" data-rank-fallback>
        <p class="rank-fallback__title">{l.title}</p>
        <p>Poredak s imenima, zastavama i rejtinzima osvježava se uživo nakon svake odigrane partije.</p>
      </div>
      <a href={l.href} target="_blank" rel="noopener noreferrer" class="rank-more">Pogledaj cijelu rang-listu <Icon name="external" size={14} /></a>
    </div>
  ))}
  <p class="rank-source">Izvor: <a href="https://2700chess.com" target="_blank" rel="noopener noreferrer">2700chess.com</a></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rank-box]').forEach((box) => {
    // official banner only once it has really loaded; otherwise keep the link card
    box.querySelectorAll<HTMLElement>('[data-rank-panel]').forEach((panel) => {
      const img = panel.querySelector<HTMLImageElement>('[data-rank-img]');
      const wrap = panel.querySelector<HTMLElement>('[data-rank-banner]');
      const fallback = panel.querySelector<HTMLElement>('[data-rank-fallback]');
      if (!img || !wrap || !fallback) return;
      const ok = () => { if (img.naturalWidth > 1) { wrap.hidden = false; fallback.hidden = true; } };
      if (img.complete) ok(); else img.addEventListener('load', ok, { once: true });
    });
    // accessible tabs: men / women
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-rank-tab]')];
    const select = (i: number, focus = false) => tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      box.querySelector<HTMLElement>(`[data-rank-panel="${t.dataset.rankTab}"]`)!.hidden = !on;
      if (on && focus) t.focus();
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); select((i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true); }
      });
    });
  });
</script>
