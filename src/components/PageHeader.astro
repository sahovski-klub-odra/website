---
import Ambient from './Ambient.astro';
interface Props { title: string; intro?: string; eyebrow?: string }
const { title, intro, eyebrow } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-ink text-white">
  <Ambient grid light lines particles={10} seed={9} pieces={[{ piece: 'knight', x: '86%', y: '14%', size: 'clamp(64px, 8vw, 112px)', motion: 'float', opacity: 0.07, desktopOnly: true }]} />
  <div class="container-site relative py-12 sm:py-16">
    {eyebrow && <p class="eyebrow mb-3 text-gold">{eyebrow}</p>}
    <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-white/75">{intro}</p>}
    <slot />
  </div>
</section>
