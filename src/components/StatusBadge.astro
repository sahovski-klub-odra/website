---
import { STATUS_STYLES, STATUS_DOT } from '../lib/schedule';
import type { Status } from '../lib/schemas';
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { status: Status; lang: Lang; class?: string }
const { status, lang, class: cls = '' } = Astro.props;
const t = useTranslations(lang);
---
<span class:list={['inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-[0.7rem] font-bold uppercase tracking-wider ring-1 ring-inset', STATUS_STYLES[status], cls]}>
  <span class:list={['h-1.5 w-1.5 rounded-full', STATUS_DOT[status]]}></span>
  {t(`schedule.status.${status}`)}
</span>
