---
/**
 * Flat chess-piece silhouettes for decorative backgrounds. Pure SVG (no image files), so they stay
 * crisp at any size and cost nothing to download. Colour comes from `currentColor`.
 */
interface Props { piece: 'knight' | 'bishop' | 'rook' | 'pawn'; class?: string; style?: string }
const { piece, class: cls = '', style } = Astro.props;
const base = 'M18 132h64v-8h-6l-4-9H28l-4 9h-6z';
---
<svg viewBox="0 0 100 140" class={cls} style={style} aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {piece === 'rook' && (
    <path fill="currentColor" d={`${base}M31 115l4-55h30l4 55zM27 60h46v-9H27zM25 51V22h11v9h8v-9h12v9h8v-9h11v29z`} />
  )}
  {piece === 'bishop' && (
    <path fill="currentColor" fill-rule="evenodd"
      d={`${base}M33 115c2-20 6-33 9-44h16c3 11 7 24 9 44zM35 71h30v-8H35zM50 15c14 9 18 27 9 46H41c-9-19-5-37 9-46zM55 27l4 4-12 13-4-4zM50 4a6 6 0 110 12 6 6 0 010-12z`} />
  )}
  {piece === 'knight' && (
    <path fill="currentColor"
      d={`${base}M27 115c-1-14 4-25 13-33 5-4 7-8 5-13-5 5-12 8-19 7-4 0-6-3-6-6 0-4 3-8 6-10 7-5 11-11 14-19l-4-11 10 6 3-10 7 10c18 3 30 18 31 39 1 15-4 28-8 40z`} />
  )}
  {piece === 'pawn' && (
    <path fill="currentColor" d={`${base}M32 115c3-16 7-28 11-38h14c4 10 8 22 11 38zM36 77h28v-8H36zM50 22a17 17 0 110 34 17 17 0 010-34z`} />
  )}
</svg>
