---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import KnightMark from './KnightMark.astro';
import { type Post, postUrl, describe, formatDate } from '../lib/blog';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/routes';

interface Props { post: Post; lang: Lang; priority?: boolean; headingLevel?: 'h2' | 'h3'; index?: number }
const { post, lang, priority = false, headingLevel: H = 'h3', index = 0 } = Astro.props;
const { title, image, imageAlt, categories, pubDate } = post.data;
const href = withBase(postUrl(post));
---
<article class="card card-lift card-light reveal group relative flex h-full flex-col overflow-hidden" style={`--reveal-delay:${Math.min(index, 8) * 70}ms`}>
  <div class="card-media relative aspect-[16/10] overflow-hidden bg-ink-2">
    {image ? (
      <Image
        src={image}
        alt={imageAlt ?? ''}
        widths={[400, 640, 800]}
        sizes="(min-width: 1280px) 360px, (min-width: 768px) 45vw, 100vw"
        class:list={['card-zoom h-full w-full object-cover', !priority && 'img-fade']}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <div class="chess-texture grid h-full place-items-center">
        <KnightMark class="h-20 w-20 text-gold/70" />
      </div>
    )}
    <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      {categories[0] && (
        <span class="cat-badge rounded-full border border-white/40 bg-ink/75 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">{categories[0]}</span>
      )}
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <H class="text-lg font-semibold leading-snug text-ink">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none group-focus-within:underline">{title}</a>
    </H>
    <p class="mt-2 line-clamp-2 text-[0.93rem] leading-relaxed text-ink/70">{describe(post, 150)}</p>
    <p class="mt-auto flex items-center gap-2 pt-4 text-sm text-ink/60">
      <Icon name="calendar" size={16} />
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
    </p>
  </div>
</article>
