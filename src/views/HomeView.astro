---
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ambient from '../components/Ambient.astro';
import Icon from '../components/Icon.astro';
import KnightMark from '../components/KnightMark.astro';
import ScheduleLive from '../components/ScheduleLive.astro';
import Announcements from '../components/Announcements.astro';
import hero from '../assets/hero.jpg';
import { postsForListing, postUrl, describe, formatDate } from '../lib/blog';
import { homepagePhotos } from '../lib/gallery';
import { site, formatAddress, wpRedirects } from '../lib/data';
import DailyPuzzle from '../components/DailyPuzzle.astro';
import ChessPiece from '../components/ChessPiece.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { routes, withBase } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await postsForListing(lang)).slice(0, 11);
const [lead, ...rest] = posts;
const practice = [
  { title: 'Igraj šah online', desc: 'Partija s prijateljem ili računalom', href: 'https://lichess.org/', piece: 'knight' },
  { title: 'Nauči igrati šah', desc: 'Pravila i osnove, korak po korak', href: 'https://lichess.org/learn', piece: 'pawn' },
  { title: 'Rješavaj šahovske zadatke', desc: 'Taktika za svaki dan', href: 'https://lichess.org/training', piece: 'rook' },
] as const;
const slides = await homepagePhotos(10);
const address = formatAddress();

const hasWpIds = Object.keys(wpRedirects.ids ?? {}).length > 0;
---
<BaseLayout lang={lang} rails>
  {hasWpIds && (
    <script slot="head" is:inline define:vars={{ ids: wpRedirects.ids, base: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
      // Old WordPress short links such as /?p=123 land on the homepage – forward them to the migrated article.
      (function () {
        var q = new URLSearchParams(location.search);
        var id = q.get('p') || q.get('page_id');
        if (id && ids[id]) location.replace(base + ids[id]);
      })();
    </script>
  )}

  <!-- ============ HERO ============ -->
  <!--
    Hero photo: src/assets/hero.jpg is 1462×627 px (and was cut from the design mockup, so it holds
    even less real detail). It is never shown wider than that on a 1× screen:
     - phones/tablets: a full-width band above the text (not a 3× blow-up behind it);
     - desktop: the right part of the hero, at most 1462 px wide, edges faded into the dark.
    The slow drift moves the photo together with its fade mask, so no hard edge can appear.
    Replace hero.jpg with a larger photo (≥ 2400 px wide) and everything here keeps working.
  -->
  <section class="hero relative isolate overflow-hidden bg-ink text-white" data-hero>
    <div class="hero-media relative -z-10 h-[min(62vw,26rem)] lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[72%] lg:max-w-[1462px]">
      <div class="hero-photo absolute inset-0 overflow-hidden">
        <Picture
          src={hero}
          formats={['webp']}
          widths={[640, 960, 1280, 1462]}
          sizes="(min-width: 1024px) 1462px, (min-width: 640px) 100vw, 150vw"
          quality={90}
          alt=""
          class="hero-img h-full w-full object-cover object-[66%_46%] lg:object-[70%_50%]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-shade absolute inset-0"></div>
    </div>
    <Ambient
      class="hero-ambient"
      pointer
      grid
      light
      lines
      particles={22}
      seed={11}
      pieces={[
        { piece: 'rook', x: '3%', y: '58%', size: 'clamp(54px, 7vw, 96px)', motion: 'bob', depth: 10, opacity: 0.06, desktopOnly: true },
        { piece: 'bishop', x: '41%', y: '9%', size: 'clamp(40px, 5vw, 70px)', motion: 'sway', depth: 18, opacity: 0.07, desktopOnly: true },
      ]}
    />

    <div class="hero-content container-site relative -mt-16 pb-16 sm:pb-20 lg:mt-0 lg:py-32">
      <div class="max-w-xl">
        <p class="hero-in hero-eyebrow eyebrow text-white/85" style="--d:80ms">{t('hero.eyebrow')}</p>
        <h1 class="hero-in hero-title mt-4 font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
          Šahovski klub <span class="text-gold">Odra</span>
        </h1>
        <p class="hero-in mt-6 text-lg leading-relaxed text-white/85 sm:text-xl" style="--d:420ms">{site.tagline || t('site.tagline')}</p>
        <div class="hero-in mt-9 flex flex-wrap gap-4" style="--d:560ms">
          <a href="#novosti" class="btn-gold">{t('hero.cta.news')} <Icon name="arrowRight" size={18} /></a>
          <a href={withBase(routes.contact[lang])} class="btn-outline"><Icon name="mail" size={18} /> {t('nav.contact')}</a>
        </div>
      </div>
    </div>
    <span class="hero-seam" aria-hidden="true"></span>
  </section>

  <!-- ============ NEWS (main column) + SIDEBAR ============ -->
  <section id="novosti" class="home-main scroll-mt-24 py-12 sm:py-14">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_340px] xl:grid-cols-[minmax(0,1fr)_370px] xl:gap-12">

      <!-- Novosti iz kluba -->
      <div class="min-w-0">
        <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
          <h2 class="section-title reveal">Novosti iz kluba</h2>
          <a href={withBase(routes.news[lang])} class="hidden items-center gap-2 font-semibold text-ink hover:text-gold-deep sm:inline-flex">Sve novosti <Icon name="arrowRight" size={18} /></a>
        </div>
        {lead ? (
          <>
            <article class="news-lead card card-lift card-light reveal group relative grid overflow-hidden md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
              <div class="card-media relative aspect-[16/10] overflow-hidden bg-ink-2 md:aspect-auto md:min-h-[300px]">
                {lead.data.image ? (
                  <Image src={lead.data.image} alt={lead.data.imageAlt ?? ''} widths={[480, 720, 960]} sizes="(min-width: 1280px) 460px, (min-width: 768px) 50vw, 100vw" loading="eager" fetchpriority="high" class="card-zoom absolute inset-0 h-full w-full object-cover" />
                ) : (
                  <div class="chess-texture absolute inset-0 grid place-items-center"><KnightMark class="h-24 w-24 text-gold/70" /></div>
                )}
                {lead.data.categories[0] && <span class="cat-badge absolute left-3 top-3 rounded-full border border-white/40 bg-ink/75 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">{lead.data.categories[0]}</span>}
              </div>
              <div class="flex flex-col p-6 sm:p-7">
                <p class="eyebrow text-gold-deep">Najnovije</p>
                <h3 class="mt-2 font-display text-2xl font-bold leading-snug text-ink sm:text-[1.7rem]">
                  <a href={withBase(postUrl(lead))} class="after:absolute after:inset-0 focus-visible:outline-none group-focus-within:underline">{lead.data.title}</a>
                </h3>
                <p class="mt-3 line-clamp-4 leading-relaxed text-ink/70">{describe(lead, 220)}</p>
                <p class="mt-auto flex items-center gap-2 pt-5 text-sm text-ink/60"><Icon name="calendar" size={16} /><time datetime={lead.data.pubDate.toISOString()}>{formatDate(lead.data.pubDate, lang)}</time></p>
              </div>
            </article>

            <ul class="news-list mt-6 grid gap-4 md:grid-cols-2">
              {rest.map((post, i) => (
                <li class="reveal" style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}>
                  <article class="news-item card card-lift card-light group relative flex h-full gap-4 overflow-hidden p-3">
                    <div class="card-media relative aspect-[4/3] w-28 shrink-0 overflow-hidden rounded-lg bg-ink-2 sm:w-32">
                      {post.data.image ? (
                        <Image src={post.data.image} alt={post.data.imageAlt ?? ''} widths={[160, 260]} sizes="130px" class="card-zoom img-fade h-full w-full object-cover" />
                      ) : (
                        <div class="chess-texture grid h-full place-items-center"><KnightMark class="h-10 w-10 text-gold/70" /></div>
                      )}
                    </div>
                    <div class="flex min-w-0 flex-1 flex-col py-0.5 pr-1">
                      <h3 class="line-clamp-2 font-semibold leading-snug text-ink">
                        <a href={withBase(postUrl(post))} class="after:absolute after:inset-0 focus-visible:outline-none group-focus-within:underline">{post.data.title}</a>
                      </h3>
                      <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-ink/65">{describe(post, 120)}</p>
                      <p class="mt-auto flex items-center gap-1.5 pt-2 text-xs text-ink/55"><Icon name="calendar" size={13} /><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time></p>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
            <div class="mt-8 text-center">
              <a href={withBase(routes.news[lang])} class="btn-dark">Sve novosti <Icon name="arrowRight" size={18} /></a>
            </div>
          </>
        ) : (
          <div class="card grid place-items-center gap-3 p-12 text-center text-ink/70">
            <KnightMark class="h-14 w-14 text-gold [--knight-cut:#fff]" />
            <p>{t('home.news.empty')}</p>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="home-sidebar grid content-start gap-5" aria-label="Klub i šah">
        <section id="o-klubu" class="side-card about-card relative scroll-mt-28 overflow-hidden">
          <KnightMark class="about-knight pointer-events-none absolute -bottom-3 -right-3 h-28 w-28 text-ink/[0.07] [--knight-cut:transparent]" />
          <h2 class="side-card__title">
            <span class="grid h-5 w-5 grid-cols-2 overflow-hidden rounded-sm" aria-hidden="true"><span class="bg-ink"></span><span class="bg-gold"></span><span class="bg-gold"></span><span class="bg-ink"></span></span>
            {t('home.about.title')}
          </h2>
          <p class="relative mt-2.5 leading-relaxed text-ink/75">{site.about}</p>
          <a href={withBase(routes.members[lang])} class="link-gold relative mt-3 inline-flex items-center gap-1.5 text-sm">Upoznajte klub i članove <Icon name="arrowRight" size={15} /></a>
        </section>

        <section class="side-card side-card--dark training-card relative overflow-hidden" aria-labelledby="next-training">
          <h2 id="next-training" class="side-card__title"><Icon name="clock" size={18} class="text-gold" /> {t('schedule.next')}</h2>
          <Announcements lang={lang} dark class="mt-3" />
          <ScheduleLive kind="next" lang={lang} class="mt-3" />
          <a href={withBase(routes.schedule[lang])} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-gold hover:text-gold-light">{t('schedule.full')} <Icon name="arrowRight" size={15} /></a>
        </section>

        <section class="side-card side-card--dark" aria-labelledby="puzzle-h">
          <h2 id="puzzle-h" class="side-card__title"><Icon name="crown" size={18} class="text-gold" /> Problem dana</h2>
          <div class="mt-3"><DailyPuzzle compact /></div>
        </section>

        <section class="side-card" aria-labelledby="practice-h">
          <h2 id="practice-h" class="side-card__title"><Icon name="play" size={18} class="text-gold-deep" /> Vježbaj šah online</h2>
          <p class="side-card__sub">Besplatno na Lichessu – i za djecu i za početnike.</p>
          <ul class="practice-links">
            {practice.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="practice-link">
                  <span class="practice-link__icon"><ChessPiece piece={l.piece} /></span>
                  <span class="practice-link__text"><span class="practice-link__title">{l.title}</span><span class="practice-link__desc">{l.desc}</span></span>
                  <Icon name="external" size={15} class="practice-link__arrow" />
                  <span class="sr-only">(otvara se u novoj kartici)</span>
                </a>
              </li>
            ))}
          </ul>
          <a href="https://lichess.org/login" target="_blank" rel="noopener noreferrer" class="practice-login link-gold"><Icon name="users" size={15} /> Prijava na Lichess<span class="sr-only"> (otvara se u novoj kartici)</span></a>
        </section>
      </aside>
    </div>
  </section>

  <!-- ============ GALLERY SLIDESHOW ============ -->
  {slides.length > 0 && (
    <section class="home-band relative isolate overflow-hidden bg-ink py-14 text-white sm:py-16" aria-labelledby="gallery-h">
      <Ambient grid light particles={8} seed={13} />
      <div class="container-site">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow text-gold">Galerija</p>
            <h2 id="gallery-h" class="mt-2 font-display text-3xl font-bold sm:text-4xl">{t('home.gallery.title')}</h2>
          </div>
          <a href={withBase(routes.gallery[lang])} class="btn-outline">Pogledaj cijelu galeriju <Icon name="arrowRight" size={18} /></a>
        </div>
        <PhotoCarousel photos={slides} />
      </div>
    </section>
  )}

  <!-- ============ CONTACT + MAP ============ -->
  <section class="py-14 sm:py-16" aria-labelledby="contact-h">
    <div class="container-site grid items-start gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)]">
      <div class="card relative overflow-hidden p-7 sm:p-8">
        <h2 id="contact-h" class="font-display text-3xl font-bold">{t('home.contact.title')}</h2>
        <p class="mt-3 text-lg text-ink/70">{t('home.contact.text')}</p>
        <div class="mt-6 flex gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-gold"><Icon name="pin" size={20} /></span>
          <address class="not-italic leading-relaxed text-ink/80">
            <strong class="font-semibold text-ink">{site.venue || site.shortName}</strong><br />
            {address.map((l) => <>{l}<br /></>)}
          </address>
        </div>
        <a href={withBase(routes.contact[lang])} class="btn-dark mt-7"><Icon name="mail" size={18} /> {t('home.contact.cta')}</a>
      </div>
      <div class="overflow-hidden rounded-xl bg-ink p-2 shadow-card ring-1 ring-gold/25">
        <GoogleMap />
      </div>
    </div>
  </section>
</BaseLayout>
