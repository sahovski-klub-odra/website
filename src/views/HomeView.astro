---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Ambient from '../components/Ambient.astro';
import Icon from '../components/Icon.astro';
import KnightMark from '../components/KnightMark.astro';
import ScheduleLive from '../components/ScheduleLive.astro';
import Announcements from '../components/Announcements.astro';
import hero from '../assets/hero.jpg';
import { postsForListing } from '../lib/blog';
import { homepagePhotos } from '../lib/gallery';
import { site, formatAddress, wpRedirects } from '../lib/data';
import DailyPuzzle from '../components/DailyPuzzle.astro';
import WorldTopTen from '../components/WorldTopTen.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { routes, withBase } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await postsForListing(lang)).slice(0, 6);
const slides = await homepagePhotos(10);
const address = formatAddress();

const hasWpIds = Object.keys(wpRedirects.ids ?? {}).length > 0;
---
<BaseLayout lang={lang} rails>
  {hasWpIds && (
    <script slot="head" is:inline define:vars={{ ids: wpRedirects.ids, base: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
      // Old WordPress short links such as /?p=123 land on the homepage – forward them to the migrated article.
      (function () {
        var q = new URLSearchParams(location.search);
        var id = q.get('p') || q.get('page_id');
        if (id && ids[id]) location.replace(base + ids[id]);
      })();
    </script>
  )}

  <!-- ============ HERO ============ -->
  <!--
    Hero photo: src/assets/hero.jpg is 1462×627 px (and was cut from the design mockup, so it holds
    even less real detail). It is never shown wider than that on a 1× screen:
     - phones/tablets: a full-width band above the text (not a 3× blow-up behind it);
     - desktop: the right part of the hero, at most 1462 px wide, edges faded into the dark.
    The slow drift moves the photo together with its fade mask, so no hard edge can appear.
    Replace hero.jpg with a larger photo (≥ 2400 px wide) and everything here keeps working.
  -->
  <section class="hero relative isolate overflow-hidden bg-ink text-white" data-hero>
    <div class="hero-media relative -z-10 h-[min(62vw,26rem)] lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[72%] lg:max-w-[1462px]">
      <div class="hero-photo absolute inset-0 overflow-hidden">
        <Picture
          src={hero}
          formats={['webp']}
          widths={[640, 960, 1280, 1462]}
          sizes="(min-width: 1024px) 1462px, (min-width: 640px) 100vw, 150vw"
          quality={90}
          alt=""
          class="hero-img h-full w-full object-cover object-[66%_46%] lg:object-[70%_50%]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-shade absolute inset-0"></div>
    </div>
    <Ambient
      class="hero-ambient"
      pointer
      grid
      light
      lines
      particles={22}
      seed={11}
      pieces={[
        { piece: 'rook', x: '3%', y: '58%', size: 'clamp(54px, 7vw, 96px)', motion: 'bob', depth: 10, opacity: 0.06, desktopOnly: true },
        { piece: 'bishop', x: '41%', y: '9%', size: 'clamp(40px, 5vw, 70px)', motion: 'sway', depth: 18, opacity: 0.07, desktopOnly: true },
      ]}
    />

    <div class="hero-content container-site relative -mt-16 pb-16 sm:pb-20 lg:mt-0 lg:py-32">
      <div class="max-w-xl">
        <p class="hero-in hero-eyebrow eyebrow text-white/85" style="--d:80ms">{t('hero.eyebrow')}</p>
        <h1 class="hero-in hero-title mt-4 font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
          Šahovski klub <span class="text-gold">Odra</span>
        </h1>
        <p class="hero-in mt-6 text-lg leading-relaxed text-white/85 sm:text-xl" style="--d:420ms">{site.tagline || t('site.tagline')}</p>
        <div class="hero-in mt-9 flex flex-wrap gap-4" style="--d:560ms">
          <a href="#novosti" class="btn-gold">{t('hero.cta.news')} <Icon name="arrowRight" size={18} /></a>
          <a href="#o-klubu" class="btn-outline"><Icon name="users" size={18} /> {t('hero.cta.club')}</a>
        </div>
      </div>
    </div>
    <span class="hero-seam" aria-hidden="true"></span>
  </section>

  <!-- ============ CLUB: about + next training ============ -->
  <section id="o-klubu" class="scroll-mt-24 py-14 sm:py-16">
    <div class="container-site grid gap-6 lg:grid-cols-2">
      <section class="about-card card relative overflow-hidden p-7 sm:p-8">
        <Ambient tone="light" grid particles={0} class="about-ambient" />
        <KnightMark class="about-knight pointer-events-none absolute -bottom-3 -right-3 h-40 w-40 text-ink/[0.07] [--knight-cut:transparent]" />
        <h2 class="flex items-center gap-2.5 font-display text-3xl font-bold">
          <span class="grid h-7 w-7 grid-cols-2 overflow-hidden rounded-sm" aria-hidden="true"><span class="bg-ink"></span><span class="bg-gold"></span><span class="bg-gold"></span><span class="bg-ink"></span></span>
          {t('home.about.title')}
        </h2>
        <p class="relative mt-4 max-w-xl text-lg leading-relaxed text-ink/75">{site.about}</p>
      </section>

      <section class="training-card relative overflow-hidden rounded-xl bg-ink p-7 text-white shadow-card sm:p-8" aria-labelledby="next-training">
        <Ambient grid particles={7} seed={3} pieces={[{ piece: 'pawn', x: '82%', y: '50%', size: '70px', motion: 'bob', opacity: 0.06 }]} />
        <h2 id="next-training" class="eyebrow flex items-center gap-2 text-gold"><Icon name="clock" size={16} /> {t('schedule.next')}</h2>
        <Announcements lang={lang} dark class="mt-4" />
        <ScheduleLive kind="next" lang={lang} class="mt-4" />
        <a href={withBase(routes.schedule[lang])} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-gold hover:text-gold-light">{t('schedule.full')} <Icon name="arrowRight" size={16} /></a>
      </section>
    </div>
  </section>

  <!-- ============ DAILY PUZZLE (Lichess) ============ -->
  <section class="home-band relative isolate overflow-hidden bg-ink py-14 text-white sm:py-16" aria-labelledby="puzzle-h">
    <Ambient grid light particles={10} seed={21} pieces={[{ piece: 'rook', x: '90%', y: '10%', size: 'clamp(60px, 7vw, 100px)', motion: 'float', opacity: 0.06, desktopOnly: true }]} />
    <div class="container-site">
      <div class="mb-8">
        <p class="eyebrow text-gold">Lichess</p>
        <h2 id="puzzle-h" class="mt-2 font-display text-3xl font-bold sm:text-4xl">Zadatak dana</h2>
        <p class="mt-2 text-lg text-white/70">Riješi današnji šahovski problem.</p>
      </div>
      <DailyPuzzle />
    </div>
  </section>

  <!-- ============ WORLD TOP 10 (2700chess.com) ============ -->
  <section class="py-14 sm:py-16" aria-labelledby="ranks-h">
    <div class="container-site">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow text-gold-deep">Šah u svijetu</p>
          <h2 id="ranks-h" class="section-title reveal mt-2">Najbolji na svijetu</h2>
        </div>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        <WorldTopTen kind="men" />
        <WorldTopTen kind="women" />
      </div>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section id="novosti" class="scroll-mt-24 bg-cream-2/60 py-14 sm:py-16">
    <div class="container-site">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="section-title reveal">{t('home.news.title')}</h2>
        <a href={withBase(routes.news[lang])} class="inline-flex items-center gap-2 font-semibold text-ink hover:text-gold-deep">
          {t('home.news.all')} <Icon name="arrowRight" size={18} />
        </a>
      </div>
      {posts.length > 0 ? (
        <div class="home-news grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => <BlogCard post={post} lang={lang} priority={i < 3} index={i} />)}
        </div>
      ) : (
        <div class="card grid place-items-center gap-3 p-12 text-center text-ink/70">
          <KnightMark class="h-14 w-14 text-gold [--knight-cut:#fff]" />
          <p>{t('home.news.empty')}</p>
        </div>
      )}
      {posts.length > 0 && (
        <div class="mt-10 text-center">
          <a href={withBase(routes.news[lang])} class="btn-dark">{t('home.news.all')} <Icon name="arrowRight" size={18} /></a>
        </div>
      )}
    </div>
  </section>

  <!-- ============ GALLERY SLIDESHOW ============ -->
  {slides.length > 0 && (
    <section class="home-band relative isolate overflow-hidden bg-ink py-14 text-white sm:py-16" aria-labelledby="gallery-h">
      <Ambient grid light particles={8} seed={13} />
      <div class="container-site">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow text-gold">Galerija</p>
            <h2 id="gallery-h" class="mt-2 font-display text-3xl font-bold sm:text-4xl">{t('home.gallery.title')}</h2>
          </div>
          <a href={withBase(routes.gallery[lang])} class="btn-outline">Pogledaj cijelu galeriju <Icon name="arrowRight" size={18} /></a>
        </div>
        <PhotoCarousel photos={slides} />
      </div>
    </section>
  )}

  <!-- ============ CONTACT + MAP ============ -->
  <section class="py-14 sm:py-16" aria-labelledby="contact-h">
    <div class="container-site grid items-start gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)]">
      <div class="card relative overflow-hidden p-7 sm:p-8">
        <h2 id="contact-h" class="font-display text-3xl font-bold">{t('home.contact.title')}</h2>
        <p class="mt-3 text-lg text-ink/70">{t('home.contact.text')}</p>
        <div class="mt-6 flex gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-gold"><Icon name="pin" size={20} /></span>
          <address class="not-italic leading-relaxed text-ink/80">
            <strong class="font-semibold text-ink">{site.venue || site.shortName}</strong><br />
            {address.map((l) => <>{l}<br /></>)}
          </address>
        </div>
        <a href={withBase(routes.contact[lang])} class="btn-dark mt-7"><Icon name="mail" size={18} /> {t('home.contact.cta')}</a>
      </div>
      <div class="overflow-hidden rounded-xl bg-ink p-2 shadow-card ring-1 ring-gold/25">
        <GoogleMap />
      </div>
    </div>
  </section>
</BaseLayout>
