---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getAlbums } from '../lib/gallery';
import { videos, youtubeId } from '../lib/data';
import { useTranslations, locales, type Lang } from '../i18n/ui';
import { withBase, albumPath } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const albums = await getAlbums(lang);
const vids = videos
  .map((v) => ({ ...v, id: youtubeId(v.youtube) }))
  .filter((v) => v.id)
  .map((v) => ({
    ...v,
    thumb: v.thumbnail ? withBase(v.thumbnail) : `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
  }));
const categories = [...new Set(albums.map((a) => a.category).filter((c): c is string => !!c))].sort((a, b) => a.localeCompare(b, locales[lang]));
const fmt = new Intl.DateTimeFormat(locales[lang], { month: 'long', year: 'numeric' });
const tabCls = 'flex items-center gap-2 border-b-2 px-1 pb-3 text-base font-semibold transition-colors';
---
<BaseLayout rails lang={lang} title={t('gallery.title')} description={t('gallery.intro')}>
  <PageHeader title={t('gallery.title')} intro={t('gallery.intro')} />
  <div class="container-site py-10">
    <div role="tablist" aria-label={t('gallery.title')} class="tabs-bar relative mb-10 flex gap-4 min-[360px]:gap-5 sm:gap-8 border-b border-ink/10" data-tabs>
      <button role="tab" id="tab-foto" aria-controls="fotografije" aria-selected="true" class={`${tabCls} border-gold text-ink`} data-tab="fotografije">
        <Icon name="camera" size={20} /> {t('gallery.photos')} <span class="text-sm font-normal text-ink/50">{albums.length}</span>
      </button>
      <button role="tab" id="tab-video" aria-controls="videozapisi" aria-selected="false" tabindex="-1" class={`${tabCls} border-transparent text-ink/60 hover:text-ink`} data-tab="videozapisi">
        <Icon name="play" size={20} /> {t('gallery.videos')} <span class="text-sm font-normal text-ink/50">{vids.length}</span>
      </button>
    </div>

    <section id="fotografije" role="tabpanel" aria-labelledby="tab-foto" class="scroll-mt-28">
      {categories.length > 1 && (
        <div class="album-filter mb-8 flex flex-wrap gap-2" role="group" aria-label={t('gallery.filter')} data-album-filter hidden>
          <button type="button" class="chip" aria-pressed="true" data-cat="">{t('gallery.all')}</button>
          {categories.map((c) => <button type="button" class="chip" aria-pressed="false" data-cat={c}>{c}</button>)}
        </div>
      )}
      {albums.length ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-albums>
          {albums.map((a, i) => (
            <li class="reveal" style={`--reveal-delay:${Math.min(i, 8) * 60}ms`} data-cat={a.category ?? ''}>
              <a href={withBase(albumPath(lang, a.id))} class="card card-lift group block overflow-hidden">
                <div class="relative aspect-[4/3] overflow-hidden bg-ink-2">
                  {a.cover && <Image src={a.cover} alt="" widths={[400, 700]} sizes="(min-width:1024px) 400px, (min-width:640px) 50vw, 100vw" class="card-zoom img-fade h-full w-full object-cover" loading={i < 3 ? 'eager' : 'lazy'} />}
                  <span class="absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-ink/80 px-3 py-1 text-xs font-medium text-white"><Icon name="image" size={14} /> {a.photos.length}</span>
                </div>
                <div class="p-5">
                  <h2 class="text-lg font-semibold group-hover:text-gold-deep">{a.title}</h2>
                  <p class="mt-1 text-sm text-ink/60">{a.season ? <span>{a.season}</span> : <span class="capitalize">{fmt.format(a.date)}</span>}{a.category && <> · <span>{a.category}</span></>}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : <p class="card p-10 text-center text-ink/70">{t('gallery.emptyPhotos')}</p>}
    </section>

    <section id="videozapisi" role="tabpanel" aria-labelledby="tab-video" class="scroll-mt-28 pt-16" data-panel-video>
      <h2 class="section-title mb-8" data-js-hide>{t('gallery.videos')}</h2>
      {vids.length ? (
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {vids.map((v) => (
            <li class="card card-lift reveal overflow-hidden">
              <div class="relative aspect-video bg-black" data-yt={v.id} data-title={v.title}>
                <img src={v.thumb} alt="" loading="lazy" decoding="async" width="480" height="360" class="card-zoom img-fade h-full w-full object-cover opacity-90" />
                <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="absolute inset-0 grid place-items-center" data-yt-play aria-label={`${t('gallery.play')}: ${v.title}`}>
                  <span class="grid h-16 w-16 place-items-center rounded-full bg-gold text-ink shadow-lg transition-transform hover:scale-110">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                </a>
              </div>
              <div class="p-5">
                <h3 class="text-lg font-semibold">{v.title}</h3>
                {v.description && <p class="mt-2 text-[0.93rem] text-ink/70">{v.description}</p>}
                <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="link-gold mt-3 inline-flex items-center gap-1 text-sm">{t('gallery.watchYoutube')} <Icon name="external" size={14} /></a>
              </div>
            </li>
          ))}
        </ul>
      ) : <p class="card p-10 text-center text-ink/70">{t('gallery.emptyVideos')}</p>}
    </section>
  </div>
</BaseLayout>

<script>
  // Accessible tabs (without JS both sections are simply shown one after another)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = tabs.map((t) => document.getElementById(t.dataset.tab!)!);
  document.querySelector<HTMLElement>('[data-panel-video]')?.classList.remove('pt-16');
  document.querySelectorAll('[data-js-hide]').forEach((el) => el.classList.add('sr-only'));
  function select(i: number, focus = false) {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      t.classList.toggle('border-gold', on); t.classList.toggle('text-ink', on);
      t.classList.toggle('border-transparent', !on); t.classList.toggle('text-ink/60', !on);
      panels[j].hidden = !on;
      if (on) { panels[j].classList.remove('panel-in'); void panels[j].offsetWidth; panels[j].classList.add('panel-in'); }
    });
    if (focus) tabs[i].focus();
    history.replaceState(null, '', `#${tabs[i].dataset.tab}`);
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
      if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
    });
  });
  const start = tabs.findIndex((t) => `#${t.dataset.tab}` === location.hash);
  tabs.forEach((_, j) => (panels[j].hidden = j !== Math.max(0, start)));
  if (start > 0) select(start);

  // Album category filter (shown only with JavaScript; without it every album is listed)
  const filter = document.querySelector<HTMLElement>('[data-album-filter]');
  if (filter) {
    filter.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>('[data-albums] > li')];
    filter.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]');
      if (!b) return;
      filter.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const cat = b.dataset.cat;
      items.forEach((li) => {
        const show = !cat || li.dataset.cat === cat;
        li.hidden = !show;
        if (show) { li.classList.remove('panel-in'); void li.offsetWidth; li.classList.add('panel-in'); }
      });
    });
  }

  // Load the YouTube player only when the visitor clicks play (fast + no tracking before consent)
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('[data-yt-play]')!.addEventListener('click', (e) => {
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1`;
      f.title = box.dataset.title ?? 'YouTube';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      f.className = 'absolute inset-0 h-full w-full border-0';
      box.replaceChildren(f);
    });
  });
</script>
