---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ScheduleLive from '../components/ScheduleLive.astro';
import Icon from '../components/Icon.astro';
import Announcements from '../components/Announcements.astro';
import { training } from '../lib/data';
import { WEEKDAYS } from '../lib/schemas';
import { timeRange } from '../lib/schedule';
import { useTranslations, dayNames, locales, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const dayLabel = (d: (typeof WEEKDAYS)[number]) => dayNames[lang][(WEEKDAYS.indexOf(d) + 1) % 7];
const week = WEEKDAYS.map((day) => ({
  day,
  sessions: training.sessions.filter((s) => s.day === day).sort((a, b) => a.startTime.localeCompare(b.startTime)),
})).filter((d) => d.sessions.length);
---
<BaseLayout lang={lang} title={t('schedule.title')} description={t('schedule.intro')}>
  <PageHeader title={t('schedule.title')} intro={t('schedule.intro')} />
  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div class="space-y-14">
      <Announcements lang={lang} class="-mb-6" />
      <section aria-labelledby="h-upcoming">
        <h2 id="h-upcoming" class="section-title mb-6">{t('schedule.upcoming')}</h2>
        <ScheduleLive kind="upcoming" lang={lang} limit={10} />
      </section>
      <section aria-labelledby="h-month">
        <h2 id="h-month" class="section-title mb-6">{t('schedule.monthly')}</h2>
        <ScheduleLive kind="month" lang={lang} />
      </section>
    </div>

    <aside class="space-y-6">
      <section class="chess-texture rounded-xl bg-ink p-6 text-white shadow-card" aria-labelledby="h-next">
        <h2 id="h-next" class="eyebrow flex items-center gap-2 text-gold"><Icon name="clock" size={16} /> {t('schedule.next')}</h2>
        <ScheduleLive kind="next" lang={lang} class="mt-4" />
      </section>

      <section class="card p-6" aria-labelledby="h-week">
        <h2 id="h-week" class="font-display text-2xl font-bold">{t('schedule.weekly')}</h2>
        {week.length ? (
          <dl class="mt-4 divide-y divide-ink/10">
            {week.map(({ day, sessions }) => (
              <div class="py-3">
                <dt class="text-sm font-semibold uppercase tracking-wider text-gold-deep">{dayLabel(day)}</dt>
                {sessions.map((s) => (
                  <dd class="mt-2">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="font-semibold">{timeRange(s.startTime, s.endTime, locales[lang])}</p>
                        <p class="text-sm text-ink/75">{s.group}</p>
                        {s.coach && <p class="text-sm text-ink/55">{t('schedule.coach')}: {s.coach}</p>}
                        {s.location && <p class="text-sm text-ink/55">{s.location}</p>}
                      </div>
                      {s.status !== 'scheduled' && <StatusBadge status={s.status} lang={lang} />}
                    </div>
                  </dd>
                ))}
              </div>
            ))}
          </dl>
        ) : <p class="mt-3 text-ink/70">{t('schedule.empty')}</p>}
      </section>
    </aside>
  </div>
</BaseLayout>
