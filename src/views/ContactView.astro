---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, formatAddress } from '../lib/data';
import GoogleMap from '../components/GoogleMap.astro';
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const address = formatAddress();
const socials = Object.entries(site.social).filter(([, u]) => u);
const names: Record<string, string> = { facebook: 'Facebook', instagram: 'Instagram', youtube: 'YouTube', lichess: 'Lichess', chesscom: 'Chess.com' };
const form = site.contactForm;
const showForm = form.provider !== 'none' && !!form.endpoint;
---
<BaseLayout rails lang={lang} title={t('contact.title')} description={t('contact.intro')}>
  <PageHeader title={t('contact.title')} intro={t('contact.intro')} />
  <div class="container-site grid gap-8 py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
    <div class="space-y-6">
      <section class="card p-6">
        <h2 class="font-display text-2xl font-bold">{site.name}</h2>
        <dl class="mt-5 space-y-5">
          <div class="flex gap-4">
            <dt class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-gold"><Icon name="pin" /><span class="sr-only">{t('contact.address')}</span></dt>
            <dd class="pt-0.5"><p class="text-sm font-semibold uppercase tracking-wider text-ink/50" aria-hidden="true">{t('contact.address')}</p><address class="not-italic">{site.venue && <>{site.venue}<br /></>}{address.map((l) => <>{l}<br /></>)}</address></dd>
          </div>
          {site.email && (
            <div class="flex gap-4">
              <dt class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-gold"><Icon name="mail" /><span class="sr-only">{t('contact.email')}</span></dt>
              <dd class="pt-0.5"><p class="text-sm font-semibold uppercase tracking-wider text-ink/50" aria-hidden="true">{t('contact.email')}</p><a class="link-gold" href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
          )}
          {site.phone && (
            <div class="flex gap-4">
              <dt class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-gold"><Icon name="phone" /><span class="sr-only">{t('contact.phone')}</span></dt>
              <dd class="pt-0.5"><p class="text-sm font-semibold uppercase tracking-wider text-ink/50" aria-hidden="true">{t('contact.phone')}</p><a class="link-gold" href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a></dd>
            </div>
          )}
        </dl>
        {!site.email && !site.phone && !site.contacts.length && <p class="mt-5 text-sm text-ink/60">{t('contact.notSet')}</p>}
        {site.contacts.length > 0 && (
          <div class="mt-6 border-t border-ink/10 pt-5">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/50">{t('contact.people')}</h3>
            <ul class="mt-3 space-y-3">
              {site.contacts.map((c, i) => (
                <li class="contact-person reveal rounded-lg bg-cream/60 p-3.5 ring-1 ring-ink/5" style={`--reveal-delay:${i * 70}ms`}>
                  <p class="font-semibold">{c.name}{c.role && <span class="ml-2 text-sm font-normal text-ink/55">{c.role}</span>}</p>
                  <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-[0.93rem]">
                    {c.phone && <a class="link-gold inline-flex items-center gap-1.5" href={`tel:+385${c.phone.replace(/\D/g, '').replace(/^0/, '')}`}><Icon name="phone" size={15} />{c.phone}</a>}
                    {c.email && <a class="link-gold inline-flex items-center gap-1.5 break-all" href={`mailto:${c.email}`}><Icon name="mail" size={15} />{c.email}</a>}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
        {site.oib && <p class="mt-5 text-sm text-ink/55">{t('contact.oib')}: {site.oib}</p>}
        {socials.length > 0 && (
          <div class="mt-6 border-t border-ink/10 pt-5">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/50">{t('contact.social')}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {socials.map(([k, u]) => <li><a href={u} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-cream px-4 py-1.5 text-sm font-medium ring-1 ring-ink/10 hover:ring-gold">{names[k] ?? k} <Icon name="external" size={13} /></a></li>)}
            </ul>
          </div>
        )}
      </section>

      {site.email && !showForm && (
        <section class="chess-texture rounded-xl bg-ink p-6 text-white">
          <h2 class="font-display text-2xl font-bold">{t('contact.write')}</h2>
          <a href={`mailto:${site.email}?subject=${encodeURIComponent(site.shortName)}`} class="btn-gold mt-4"><Icon name="mail" size={18} /> {t('contact.mailto')}</a>
        </section>
      )}

      {showForm && (
        <section class="card p-6">
          <h2 class="font-display text-2xl font-bold">{t('contact.write')}</h2>
          <form action={form.endpoint} method="POST" class="mt-5 space-y-4">
            {form.provider === 'web3forms' && form.accessKey && <input type="hidden" name="access_key" value={form.accessKey} />}
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div><label for="cf-name" class="mb-1 block text-sm font-semibold">{t('contact.form.name')}</label><input id="cf-name" name="name" required autocomplete="name" class="w-full rounded-md border border-ink/20 px-4 py-2.5 focus:border-gold focus:outline-none" /></div>
            <div><label for="cf-email" class="mb-1 block text-sm font-semibold">{t('contact.form.email')}</label><input id="cf-email" name="email" type="email" required autocomplete="email" class="w-full rounded-md border border-ink/20 px-4 py-2.5 focus:border-gold focus:outline-none" /></div>
            <div><label for="cf-msg" class="mb-1 block text-sm font-semibold">{t('contact.form.message')}</label><textarea id="cf-msg" name="message" rows="5" required class="w-full rounded-md border border-ink/20 px-4 py-2.5 focus:border-gold focus:outline-none"></textarea></div>
            <button class="btn-dark">{t('contact.form.send')}</button>
          </form>
        </section>
      )}
    </div>

    <section class="contact-map overflow-hidden rounded-xl bg-ink p-2 shadow-card ring-1 ring-gold/25 lg:sticky lg:top-28 lg:self-start" aria-labelledby="h-map">
      <h2 id="h-map" class="sr-only">{t('contact.map')}</h2>
      <GoogleMap height="h-[380px] sm:h-[440px] lg:h-[520px]" />
    </section>
  </div>
</BaseLayout>
