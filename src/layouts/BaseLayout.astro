---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SideRails from '../components/SideRails.astro';
import { site } from '../lib/data';
import { useTranslations, type Lang } from '../i18n/ui';
import { withBase, rssPath } from '../i18n/routes';
import defaultOg from '../assets/hero.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  published?: Date;
  modified?: Date;
  /** override highlighted nav item */
  section?: string;
  /** slow chess-themed motion in the side margins on wide desktop screens */
  rails?: boolean;
}

const {
  lang,
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
  published,
  modified,
  section,
  rails = false,
} = Astro.props;

const t = useTranslations(lang);
const siteName = site.name;
const fullTitle = title ? `${title} | ${site.shortName}` : `${siteName} – ${t('site.tagline')}`;
const desc = description || site.about;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p: string) => new URL(withBase(p), Astro.site).href;

const og = await getImage({ src: image ?? defaultOg, width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  '@id': `${abs('/')}#organization`,
  name: site.name,
  alternateName: [site.shortName],
  sport: 'Chess',
  url: abs('/'),
  logo: new URL(withBase('/favicon.svg'), Astro.site).href,
  ...(site.email && { email: site.email }),
  ...(site.phone && { telephone: site.phone }),
  address: {
    '@type': 'PostalAddress',
    ...(site.address.street && { streetAddress: site.address.street }),
    ...(site.address.postalCode && { postalCode: site.address.postalCode }),
    addressLocality: [site.address.locality, site.address.city].filter(Boolean).join(', '),
    addressCountry: 'HR',
  },
  sameAs: Object.values(site.social).filter(Boolean),
};
const ld = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang={lang} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Animations only when JS runs and the visitor has not asked for reduced motion (see styles/motion.css)
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.documentElement.classList.add('motion');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#17191C" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.shortName} – ${t('nav.news')}`} href={withBase(rssPath(lang))} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={imageAlt ?? siteName} />
    <meta property="og:locale" content="hr_HR" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <noscript><style>[data-cal-nav], [data-js-only] { display: none !important; }</style></noscript>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="nav-progress" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-gold focus:px-4 focus:py-2 focus:text-ink">
      {t('nav.skip')}
    </a>
    <Header lang={lang} section={section} />
    <main id="main" class:list={['flex-1', rails && 'page-stage']}>
      {rails && <SideRails variant="page" />}
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
