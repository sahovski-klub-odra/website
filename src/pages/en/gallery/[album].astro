---
import AlbumView from '../../../views/AlbumView.astro';
import { getAlbums } from '../../../lib/gallery';
export async function getStaticPaths() {
  return (await getAlbums('en')).map((album) => ({ params: { album: album.id }, props: { album } }));
}
---
<AlbumView lang="en" album={Astro.props.album} />
