---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnightMark from '../components/KnightMark.astro';
import { wpRedirects } from '../lib/data';
import { ui } from '../i18n/ui';
import { withBase } from '../i18n/routes';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout lang="hr" title={ui.hr['404.title']} noindex>
  <script slot="head" is:inline define:vars={{ paths: wpRedirects.paths, ids: wpRedirects.ids, base }}>
    // Fallback redirects for old WordPress URLs not covered by a generated redirect page
    // (e.g. different letter case, URL-encoded characters, /?p=123, /category/…).
    (function () {
      var p = location.pathname;
      if (base && p.indexOf(base) === 0) p = p.slice(base.length) || '/';
      try { p = decodeURIComponent(p); } catch (e) {}
      p = p.toLowerCase();
      if (p.slice(-1) !== '/') p += '/';
      var q = new URLSearchParams(location.search);
      var target = paths[p] || ids[q.get('p') || q.get('page_id') || ''];
      if (!target) {
        var m = p.match(/^\/(?:category|kategorija)\/(?:.*\/)?([^/]+)\/$/);
        if (m) target = '/novosti/kategorija/' + m[1] + '/';
        m = p.match(/^\/tag\/([^/]+)\/$/);
        if (m) target = '/novosti/pretraga/?q=' + encodeURIComponent(m[1].replace(/-/g, ' '));
        if (/^\/(feed|rss)\/$/.test(p)) target = '/rss.xml';
        // former English pages (/en/…): open the Croatian page
        if (/^\/en\//.test(p)) {
          var en = p.slice(3);
          target = en.replace(/^\/news\/category\//, '/novosti/kategorija/').replace(/^\/news\/page\//, '/novosti/stranica/')
            .replace(/^\/news\/search\//, '/novosti/pretraga/').replace(/^\/news\//, '/novosti/').replace(/^\/members\//, '/clanovi/')
            .replace(/^\/gallery\//, '/galerija/').replace(/^\/schedule\//, '/raspored/').replace(/^\/contact\//, '/kontakt/');
        }
      }
      if (target) { document.documentElement.dataset.redirecting = '1'; location.replace(base + target); }
    })();
  </script>
  <section class="container-site grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <KnightMark class="mx-auto h-24 w-24 text-gold [--knight-cut:#f5f0e6]" />
      <p class="mt-4 font-display text-7xl font-bold text-ink/15">404</p>
      <h1 class="mt-2 font-display text-3xl font-bold">{ui.hr['404.title']}</h1>
      <p class="mt-3 text-ink/70">{ui.hr['404.text']}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase('/')} class="btn-dark">{ui.hr['404.home']}</a>
      </div>
    </div>
  </section>
</BaseLayout>
