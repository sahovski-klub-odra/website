{
  "name": "sk-odra-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-vendor-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "build": "astro check && tsc --noEmit && astro build && node scripts/check-admin-config.mjs && node scripts/check-build-output.mjs",
    "build:fast": "node scripts/copy-vendor-assets.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate-wordpress.ts",
    "verify:migration": "tsx scripts/verify-migration.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@sveltia/cms": "0.270.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "chess.js": "^1.4.0",
    "cm-chessboard": "^8.15.8",
    "hast-util-raw": "^9.2.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@types/turndown": "^5.0.6",
    "fast-xml-parser": "^5.12.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "description": "Static website for Šahovski klub Odra (Astro + GitHub Pages)",
  "engines": {
    "node": ">=22.23.4"
  }
}
